---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getServicios, getGaleria } from "../lib/api";

const servicios = await getServicios();
const trabajos = await getGaleria();
const destacados = trabajos.slice(0, 4);
---

<Layout>
    <Hero />

    <!-- Servicios destacados -->
    <section class="px-12 py-20 max-w-6xl mx-auto">
        <div class="mb-12 text-center">
            <span class="text-xs tracking-[0.2em] uppercase text-muted">Qué ofrecemos</span>
            <h2 class="font-display text-4xl font-light text-dark mt-3">Servicios de atelier</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {servicios.map((s) => (
                <a href={s.href} class="group bg-cream p-8 flex flex-col gap-4 hover:bg-dark hover:text-white transition-colors duration-300">
                    <span class="font-display text-3xl font-light text-inherit">{s.icono}</span>
                    <h3 class="font-display text-xl font-light text-inherit">{s.titulo}</h3>
                    <p class="text-xs text-muted leading-relaxed group-hover:text-white/60 transition-colors">{s.resumen}</p>
                    <span class="text-xs tracking-widest uppercase mt-auto pt-4 border-t border-dark/10 group-hover:border-white/20">
                        Saber más →
                    </span>
                </a>
            ))}
        </div>
    </section>

    <!-- Galería breve -->
    <section class="px-12 py-20 bg-cream">
        <div class="max-w-6xl mx-auto">
            <div class="mb-10 text-center">
                <span class="text-xs tracking-[0.2em] uppercase text-muted">Nuestros trabajos</span>
                <h2 class="font-display text-4xl font-light text-dark mt-3">Galería</h2>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {destacados.map((t) => (
                    <a href="/galeria" class="aspect-[3/4] overflow-hidden bg-white group">
                        <img
                            src={t.imagen}
                            alt={t.titulo}
                            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                        />
                    </a>
                ))}
            </div>

            <div class="text-center mt-10">
                <a
                    href="/galeria"
                    class="inline-block border border-dark text-dark text-xs tracking-widest uppercase px-6 py-3 hover:bg-dark hover:text-white transition-colors duration-300"
                >
                    Ver galería completa
                </a>
            </div>
        </div>
    </section>

    <!-- CTA cita -->
    <section class="px-12 py-20 text-center max-w-xl mx-auto">
        <span class="text-xs tracking-[0.2em] uppercase text-muted">Atención personalizada</span>
        <h2 class="font-display text-4xl font-light text-dark mt-3 mb-6">¿Hablamos de tu proyecto?</h2>
        <p class="text-sm text-muted leading-relaxed mb-8">
            Cada prenda es única, como tú. Cuéntanos qué necesitas y te asesoramos sin compromiso.
        </p>
        <a
            href="/cita"
            class="inline-block bg-dark text-white text-xs tracking-widest uppercase px-8 py-4 hover:bg-muted transition-colors duration-300"
        >
            Reservar cita
        </a>
    </section>

</Layout>
