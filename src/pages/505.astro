---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Error del servidor – Atelier Carmen">
  <section class="px-12 py-32 max-w-xl mx-auto text-center">

    <span class="font-display text-[120px] font-light text-gray-100 leading-none block">500</span>

    <div class="-mt-4">
      <h1 class="font-display text-4xl font-light text-dark mb-4">
        Algo ha salido mal
      </h1>
      <p class="text-sm text-muted leading-relaxed mb-10">
        Ha ocurrido un error en nuestro servidor.<br />
        Estamos trabajando para solucionarlo. Por favor, inténtalo de nuevo en unos minutos<br />
        o contáctanos directamente.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 justify-center mb-10">
      <a
        href="/"
        class="bg-dark text-white text-xs tracking-widest uppercase px-6 py-4 hover:bg-muted transition-colors duration-300"
      >
        Volver al inicio
      </a>
      <a
        href="/contacto"
        class="border border-dark text-dark text-xs tracking-widest uppercase px-6 py-4 hover:bg-dark hover:text-white transition-colors duration-300"
      >
        Contactar
      </a>
    </div>

    <p class="text-xs text-muted">
      También puedes llamarnos al
      <a href="tel:964836014" class="text-dark hover:underline">964 83 60 14</a>
    </p>

  </section>
</Layout>