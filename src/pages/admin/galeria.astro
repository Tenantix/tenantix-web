---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabase } from "../../lib/supabase";

const { data: trabajos, error } = await supabase
    .from("trabajos")
    .select("*, imagenes_trabajo(url, orden)")
    .order("created_at", { ascending: false });
---

<AdminLayout>
    <div class="flex items-center justify-between mb-10">
        <div>
            <h1 class="font-display text-4xl font-light text-dark">Galería</h1>
            <p class="text-sm text-muted mt-1">Gestiona los trabajos del portafolio</p>
        </div>
        <button id="btn-nuevo" class="bg-dark text-white text-xs tracking-widest uppercase px-5 py-3 hover:bg-muted transition-colors">
            + Nuevo trabajo
        </button>
    </div>

    {error && <p class="text-xs text-red-500 mb-6">Error: {error.message}</p>}

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {trabajos?.map((t) => (
            <div class="bg-cream overflow-hidden group" data-id={t.id}>
                <div class="aspect-[3/4] overflow-hidden relative">
                    <img src={t.imagen} alt={t.titulo} class="w-full h-full object-cover object-top" />
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-center justify-center gap-2">
                        <button class="btn-editar text-white text-xs tracking-widest uppercase px-3 py-2 border border-white/60 hover:bg-white hover:text-dark transition-colors opacity-0 group-hover:opacity-100">
                            Editar
                        </button>
                        <button class="btn-eliminar text-white text-xs tracking-widest uppercase px-3 py-2 border border-red-400/60 hover:bg-red-500 hover:text-white transition-colors opacity-0 group-hover:opacity-100">
                            Eliminar
                        </button>
                    </div>
                </div>
                <div class="p-4">
                    <h3 class="font-display text-lg font-light">{t.titulo}</h3>
                    <span class="text-[10px] tracking-widest uppercase text-muted">{t.categoria}</span>
                </div>
            </div>
        ))}
    </div>

    {(!trabajos || trabajos.length === 0) && (
        <p class="text-sm text-muted text-center py-20">No hay trabajos en la galería todavía.</p>
    )}

    <!-- Modal nuevo/editar -->
    <div id="modal" class="fixed inset-0 z-50 bg-black/50 hidden items-center justify-center">
        <div class="bg-white w-full max-w-lg mx-4 p-8">
            <h2 id="modal-title" class="font-display text-2xl font-light mb-6">Nuevo trabajo</h2>

            <form id="form-trabajo" class="flex flex-col gap-4">
                <input type="hidden" id="edit-id" />

                <div class="flex flex-col gap-1">
                    <label class="text-xs tracking-widest uppercase text-muted">Título</label>
                    <input id="f-titulo" required class="border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-dark" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs tracking-widest uppercase text-muted">Categoría</label>
                    <input id="f-categoria" class="border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-dark" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs tracking-widest uppercase text-muted">URL imagen principal</label>
                    <input id="f-imagen" type="url" class="border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-dark" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs tracking-widest uppercase text-muted">URLs imágenes adicionales (una por línea)</label>
                    <textarea id="f-imagenes" rows="3" class="border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-dark resize-none"></textarea>
                </div>

                <div class="flex gap-3 justify-end mt-2">
                    <button type="button" id="btn-cancelar" class="text-xs tracking-widest uppercase px-5 py-3 border border-dark text-dark hover:bg-dark hover:text-white transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" class="bg-dark text-white text-xs tracking-widest uppercase px-5 py-3 hover:bg-muted transition-colors">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</AdminLayout>

<script>
    const modal = document.getElementById("modal")!;
    const form = document.getElementById("form-trabajo") as HTMLFormElement;
    const editId = document.getElementById("edit-id") as HTMLInputElement;
    const modalTitle = document.getElementById("modal-title")!;
    const fTitulo = document.getElementById("f-titulo") as HTMLInputElement;
    const fCategoria = document.getElementById("f-categoria") as HTMLInputElement;
    const fImagen = document.getElementById("f-imagen") as HTMLInputElement;
    const fImagenes = document.getElementById("f-imagenes") as HTMLTextAreaElement;

    function abrirModal(trabajo?: { id: number; titulo: string; categoria: string; imagen: string; imagenes?: string[] }) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        editId.value = trabajo?.id?.toString() || "";
        modalTitle.textContent = trabajo ? "Editar trabajo" : "Nuevo trabajo";
        fTitulo.value = trabajo?.titulo || "";
        fCategoria.value = trabajo?.categoria || "";
        fImagen.value = trabajo?.imagen || "";
        fImagenes.value = trabajo?.imagenes?.join("\n") || "";
    }

    function cerrarModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        form.reset();
        editId.value = "";
    }

    document.getElementById("btn-nuevo")?.addEventListener("click", () => abrirModal());
    document.getElementById("btn-cancelar")?.addEventListener("click", cerrarModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) cerrarModal(); });

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const payload = {
            titulo: fTitulo.value,
            categoria: fCategoria.value,
            imagen: fImagen.value,
            imagenes: fImagenes.value.split("\n").filter(Boolean),
        };

        const id = editId.value;
        const url = id ? `/api/admin/trabajos?id=${id}` : "/api/admin/trabajos";
        const method = id ? "PUT" : "POST";

        const res = await fetch(url, { method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });

        if (res.ok) {
            window.location.reload();
        } else {
            const data = await res.json();
            alert(data.error || "Error al guardar");
        }
    });

    document.querySelectorAll(".btn-editar").forEach((btn) => {
        btn.addEventListener("click", () => {
            const card = (btn as HTMLElement).closest("[data-id]") as HTMLElement;
            const id = Number(card.dataset.id);
            const titulo = card.querySelector("h3")?.textContent || "";
            const categoria = card.querySelector("span")?.textContent || "";
            const img = card.querySelector("img")?.src || "";
            abrirModal({ id, titulo, categoria, imagen: img });
        });
    });

    document.querySelectorAll(".btn-eliminar").forEach((btn) => {
        btn.addEventListener("click", async () => {
            if (!confirm("¿Eliminar este trabajo?")) return;
            const card = (btn as HTMLElement).closest("[data-id]") as HTMLElement;
            const id = card.dataset.id;
            const res = await fetch(`/api/admin/trabajos?id=${id}`, { method: "DELETE" });
            if (res.ok) window.location.reload();
            else alert("Error al eliminar");
        });
    });
</script>
