---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin – Iniciar sesión">
    <section class="min-h-[80vh] flex items-center justify-center px-6">
        <div class="w-full max-w-sm">
            <div class="mb-10 text-center">
                <h1 class="font-display text-4xl font-light text-dark">Iniciar sesión</h1>
                <p class="text-sm text-muted mt-2">Acceso al panel de administración</p>
            </div>

            <form id="login-form" class="flex flex-col gap-5">
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs tracking-widest uppercase text-muted">Email</label>
                    <input
                        id="email"
                        type="email"
                        required
                        class="border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-dark transition-colors"
                    />
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-xs tracking-widest uppercase text-muted">Contraseña</label>
                    <input
                        id="password"
                        type="password"
                        required
                        class="border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-dark transition-colors"
                    />
                </div>

                <p id="error" class="hidden text-xs text-red-500 text-center">Credenciales inválidas</p>

                <button
                    type="submit"
                    class="bg-dark text-white text-xs tracking-widest uppercase px-6 py-4 hover:bg-muted transition-colors disabled:opacity-50"
                >
                    Entrar
                </button>
            </form>
        </div>
    </section>
</Layout>

<script>
    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorMsg = document.getElementById("error") as HTMLParagraphElement;

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.classList.add("hidden");

        const email = (document.getElementById("email") as HTMLInputElement).value;
        const password = (document.getElementById("password") as HTMLInputElement).value;

        const res = await fetch("/api/auth/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password }),
        });

        if (res.ok) {
            window.location.href = "/admin";
        } else {
            errorMsg.classList.remove("hidden");
        }
    });
</script>
