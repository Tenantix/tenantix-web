---
import Layout from "../../layouts/Layout.astro";
import StickyBar from "../../components/StickyBar.astro";
import { getCatalogo } from "../../lib/api.ts";

const vestidos = await getCatalogo();
const categorias = ["todos", "novia", "madrina", "fiesta", "otro"];
---

<Layout title="Catálogo – Carmen Selección">
    <section class="px-12 py-16">

        <!-- Cabecera -->
        <div class="mb-10">
            <span class="text-xs tracking-[0.2em] uppercase text-muted">Colección</span>
            <h1 class="font-display text-5xl font-light text-dark mt-2">Catálogo</h1>
        </div>

        <!-- Filtros -->
        <div id="filtros" class="flex gap-3 flex-wrap mb-10">
            {categorias.map((cat) => (
                    <button
                            data-cat={cat}
                            class={`filtro-btn text-xs tracking-widest uppercase px-5 py-2 border transition-colors duration-200 ${
                                cat === "todos"
                                    ? "bg-dark text-white border-dark"
                                    : "bg-white text-dark border-dark hover:bg-dark hover:text-white"
                            }`}
                    >
                        {cat}
                    </button>
            ))}
        </div>

        <!-- Grid -->
        <div id="grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {vestidos.map((v) => (
                    <div
                            class="vestido-card group"
                            data-categoria={v.categoria}
                    >
                        <!-- Imagen -->
                        <div class="aspect-[2/3] overflow-hidden bg-cream relative">
                            <img
                                    src={v.imagen}
                                    alt={v.titulo}
                                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                            />
                            {v.nuevo && (
                                    <span class="absolute top-3 left-3 bg-dark text-white text-[10px] tracking-widest uppercase px-2 py-1">
                Nuevo
              </span>
                            )}
                        </div>

                        <!-- Info -->
                        <div class="mt-3 flex flex-col gap-2">
                            <div>
                                <p class="text-sm font-medium text-dark">{v.titulo}</p>
                                <p class="text-xs text-muted capitalize">{v.categoria}</p>
                            </div>
                            <a
                                    href={`/catalogo/${v.id}`}
                                    class="self-start text-xs tracking-widest uppercase border border-dark px-4 py-2 hover:bg-dark hover:text-white transition-colors duration-200"
                            >
                                Ver detalle
                            </a>
                        </div>
                    </div>
            ))}
        </div>

        <!-- Estado vacío -->
        <p id="empty" class="hidden text-sm text-muted mt-12 text-center">
            No hay vestidos en esta categoría.
        </p>

    </section>
    <StickyBar />
</Layout>

<script>
    const botones = document.querySelectorAll<HTMLButtonElement>(".filtro-btn");
    const cards = document.querySelectorAll<HTMLElement>(".vestido-card");
    const empty = document.getElementById("empty")!;

    function filtrar(cat: string) {
        let visibles = 0;

        cards.forEach((card) => {
            const match = cat === "todos" || card.dataset.categoria === cat;
            card.style.display = match ? "" : "none";
            if (match) visibles++;
        });

        empty.classList.toggle("hidden", visibles > 0);

        botones.forEach((btn) => {
            const activo = btn.dataset.cat === cat;
            btn.classList.toggle("bg-dark", activo);
            btn.classList.toggle("text-white", activo);
            btn.classList.toggle("border-dark", true);
            btn.classList.toggle("bg-white", !activo);
            btn.classList.toggle("text-dark", !activo);
        });
    }

    botones.forEach((btn) => {
        btn.addEventListener("click", () => filtrar(btn.dataset.cat!));
    });
</script>