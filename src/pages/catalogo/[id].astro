---
import Layout from "../../layouts/Layout.astro";
import StickyBar from "../../components/StickyBar.astro";
import { getVestidoById, getCatalogo } from "../../lib/api";

export async function getStaticPaths() {
    const vestidos = await getCatalogo();
    return vestidos.map((v) => ({ params: { id: String(v.id) } }));
}

const { id } = Astro.params;
const vestido = await getVestidoById(Number(id));

if (!vestido) {
    return Astro.redirect("/catalogo");
}

const imagenes = vestido.imagenes ?? [vestido.imagen];
---

<Layout title={`${vestido.titulo} – Carmen Selección`}>
    <section class="px-12 py-16 max-w-6xl mx-auto">

        <!-- Volver -->
        <a href="/catalogo" class="text-xs tracking-widest uppercase text-muted hover:text-dark transition-colors flex items-center gap-2 mb-10">
            ← Volver al catálogo
        </a>

        <div class="grid md:grid-cols-2 gap-12">

            <!-- Galería izquierda -->
            <div class="flex gap-3">
                <!-- Miniaturas -->
                <div class="flex flex-col gap-2">
                    {imagenes.map((src, i) => (
                            <button
                                    class="miniatura w-16 h-20 overflow-hidden border-2 transition-colors duration-200 border-transparent"
                                    data-src={src}
                                    data-index={i}
                            >
                                <img src={src} alt={`Vista ${i + 1}`} class="w-full h-full object-cover object-top" />
                            </button>
                    ))}
                </div>

                <!-- Imagen principal -->
                <div class="flex-1 aspect-[2/3] overflow-hidden bg-cream">
                    <img
                            id="imagen-principal"
                            src={imagenes[0]}
                            alt={vestido.titulo}
                            class="w-full h-full object-cover object-top transition-opacity duration-300"
                    />
                </div>
            </div>

            <!-- Info derecha -->
            <div class="flex flex-col justify-center">
                {vestido.nuevo && (
                        <span class="text-xs tracking-[0.2em] uppercase text-muted mb-3">Novedad</span>
                )}

                <h1 class="font-display text-5xl font-light text-dark leading-tight mb-2">
                    {vestido.titulo}
                </h1>

                <p class="text-xs tracking-widest uppercase text-muted mb-8 capitalize">
                    {vestido.categoria}
                </p>

                <p class="text-sm text-muted leading-relaxed mb-10">
                    {vestido.descripcion}
                </p>

                <div class="flex flex-col gap-3">
                    <a
                            href="/cita"
                            class="text-center bg-dark text-white text-xs tracking-widest uppercase px-6 py-4 hover:bg-muted transition-colors duration-300"
                    >
                        Reservar cita para probármelo
                    </a>
                    <a
                            href="/catalogo"
                            class="text-center border border-dark text-dark text-xs tracking-widest uppercase px-6 py-4 hover:bg-dark hover:text-white transition-colors duration-300"
                    >
                        Ver más vestidos
                    </a>
                </div>

                <p class="mt-8 text-xs text-muted">
                    {vestido.disponible
                        ? "✓ Disponible para prueba en tienda"
                        : "Consultar disponibilidad"}
                </p>
            </div>
        </div>

    </section>
    <StickyBar />
</Layout>

<script>
    const principal = document.getElementById("imagen-principal") as HTMLImageElement;
    const miniaturas = document.querySelectorAll<HTMLButtonElement>(".miniatura");

    function setActiva(index: number) {
        miniaturas.forEach((btn, i) => {
            btn.classList.toggle("border-dark", i === index);
            btn.classList.toggle("border-transparent", i !== index);
        });
    }

    setActiva(0);

    miniaturas.forEach((btn, i) => {
        btn.addEventListener("click", () => {
            principal.style.opacity = "0";
            setTimeout(() => {
                principal.src = btn.dataset.src!;
                principal.style.opacity = "1";
            }, 150);
            setActiva(i);
        });
    });
</script>