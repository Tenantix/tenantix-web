---
import Layout from "../layouts/Layout.astro";

const MAPS_URL = "https://www.google.com/maps/place/Av.+Jaime+Chicharro,+5,+12530+Borriana,+Castell%C3%B3n";
const MAPS_EMBED = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3078.5!2d-0.0808!3d39.8876!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd60040f8faad2d1%3A0x3faff8e10d3ea62!2sAv.%20Jaime%20Chicharro%2C%205%2C%2012530%20Borriana%2C%20Castell%C3%B3n!5e0!3m2!1ses!2ses!4v1234567890";
---

<Layout title="Contacto – Atelier Carmen">
  <section class="px-12 py-24 max-w-5xl mx-auto">

    <div class="mb-16">
      <span class="text-xs tracking-[0.2em] uppercase text-muted">Estamos en Burriana</span>
      <h1 class="font-display text-6xl font-light text-dark mt-3">Contacto</h1>
    </div>

    <div class="grid md:grid-cols-2 gap-16">

      <!-- Info -->
      <div class="flex flex-col gap-10">

        <!-- Dirección -->
        <div>
          <p class="text-xs tracking-widest uppercase text-muted mb-3">Dirección</p>
          <a
            href={MAPS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-dark hover:text-muted transition-colors leading-relaxed flex items-start gap-3 group"
          >
            <svg class="w-4 h-4 mt-0.5 shrink-0 group-hover:text-muted transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>
              Av. Jaime Chicharro, 5<br />
              12530 Burriana, Castellón
            </span>
          </a>
        </div>

        <!-- Teléfono -->
        <div>
          <p class="text-xs tracking-widest uppercase text-muted mb-3">Teléfono</p>
          <a
            href="tel:964836014"
            class="text-sm text-dark hover:text-muted transition-colors flex items-center gap-3 group"
          >
            <svg class="w-4 h-4 shrink-0 group-hover:text-muted transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            964 83 60 14
          </a>
        </div>

        <!-- Horario -->
        <div>
          <p class="text-xs tracking-widest uppercase text-muted mb-3">Horario</p>
          <div class="text-sm text-dark flex items-start gap-3">
            <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="flex flex-col gap-1">
              <span>Lunes – Sábado</span>
              <span class="text-muted">10:00 a 14:00 / 17:00 a 20:30</span>
              <span class="text-muted mt-1">Domingos cerrado</span>
            </div>
          </div>
        </div>

        <!-- CTA cita -->
        <div class="pt-4 border-t border-gray-100">
          <p class="text-sm text-muted mb-4 leading-relaxed">
            ¿Prefieres que te atendamos de forma personalizada? Reserva tu cita y nos adaptamos a ti.
          </p>
          <a
            href="/cita"
            class="inline-block bg-dark text-white text-xs tracking-widest uppercase px-6 py-4 hover:bg-muted transition-colors duration-300"
          >
            Reservar cita
          </a>
        </div>

      </div>

      <!-- Mapa -->
      <div class="flex flex-col gap-4">
        <div class="w-full aspect-[4/3] overflow-hidden bg-cream">
          <iframe
            src={MAPS_EMBED}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Atelier Carmen"
          ></iframe>
        </div>
        <a
          href={MAPS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="self-start text-xs tracking-widest uppercase border border-dark text-dark px-5 py-3 hover:bg-dark hover:text-white transition-colors duration-200"
        >
          Cómo llegar →
        </a>
      </div>

    </div>
  </section>
</Layout>