---
import Layout from "../layouts/Layout.astro";

import { getServicios } from "../lib/api";

const servicios = await getServicios();
---

<Layout title="Servicios – Atelier Carmen">
    <section class="px-12 py-24 max-w-5xl mx-auto">

        <div class="mb-20">
            <span class="text-xs tracking-[0.2em] uppercase text-muted">Lo que hacemos</span>
            <h1 class="font-display text-6xl font-light text-dark mt-3">Servicios de atelier</h1>
        </div>

        <div class="flex flex-col gap-32">
            {servicios.map((s, i) => (
                <div class={`grid md:grid-cols-2 gap-16 items-center ${i % 2 !== 0 ? "md:[direction:rtl]" : ""}`}>

                    <!-- Imagen -->
                    <div class="aspect-[3/4] overflow-hidden bg-cream md:[direction:ltr]">
                        <img
                            src={s.imagen}
                            alt={s.titulo}
                            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                        />
                    </div>

                    <!-- Texto -->
                    <div class="flex flex-col gap-6 md:[direction:ltr]">
                        <span class="font-display text-7xl font-light text-gray-100">{s.icono}</span>
                        <div class="-mt-8">
                            <p class="text-xs tracking-widest uppercase text-muted mb-2">{s.subtitulo}</p>
                            <h2 class="font-display text-4xl font-light text-dark">{s.titulo}</h2>
                        </div>
                        <p class="text-sm text-muted leading-relaxed">{s.descripcion}</p>
                        <a
                            href="/cita"
                            class="self-start text-xs tracking-widest uppercase border border-dark text-dark px-6 py-3 hover:bg-dark hover:text-white transition-colors duration-200 mt-2"
                        >
                            Solicitar presupuesto
                        </a>
                    </div>

                </div>
            ))}
        </div>

    </section>
</Layout>
