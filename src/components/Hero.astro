---
import { getHeroSlides } from "../lib/api";

const slides = await getHeroSlides();
---

<section class="bg-cream flex flex-col md:flex-row items-stretch min-h-[480px]">
    <!-- Columna izquierda: texto -->
    <div class="flex flex-col justify-center px-12 py-16 md:w-2/5">
        <span class="text-xs tracking-[0.2em] uppercase text-muted mb-4">
            Atelier en Burriana
        </span>
        <h1 class="font-display text-5xl leading-tight font-light text-dark mb-6">
            Donde tus ideas<br />
            <em class="font-display">cobran forma</em>
        </h1>
        <p class="text-sm text-muted leading-relaxed mb-8">
            Confección a medida, arreglos, asesoría de imagen y alquiler.<br />
            Prendas únicas con atención personalizada.
        </p>
        <div class="flex flex-wrap gap-3">
            <a
                    href="/servicios"
                    class="bg-dark text-white text-xs tracking-widest uppercase px-6 py-3 hover:bg-muted transition-colors duration-300"
            >
                Nuestros servicios
            </a>
            <a
                    href="/cita"
                    class="border border-dark text-dark text-xs tracking-widest uppercase px-6 py-3 hover:bg-dark hover:text-white transition-colors duration-300"
            >
                Reservar cita
            </a>
        </div>
    </div>

    <!-- Columna derecha: carrusel -->
    <div class="md:w-3/5 relative overflow-hidden">
        <div id="carousel-track" class="flex h-full transition-transform duration-500 ease-in-out">
            {slides.map((src, i) => (
                    <div class="min-w-[25%] h-full">
                        <img
                                src={src}
                                alt={`Trabajo ${i + 1}`}
                                class="w-full h-full object-cover object-top"
                        />
                    </div>
            ))}
        </div>

        <button
                id="prev"
                class="absolute left-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-dark w-8 h-8 flex items-center justify-center transition-colors text-xl"
                aria-label="Anterior"
        >
            ‹
        </button>
        <button
                id="next"
                class="absolute right-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-dark w-8 h-8 flex items-center justify-center transition-colors text-xl"
                aria-label="Siguiente"
        >
            ›
        </button>
    </div>
</section>

<script>
    const track = document.getElementById("carousel-track") as HTMLElement;
    const totalSlides = track.children.length;
    const visibleSlides = 4;
    const maxOffset = totalSlides - visibleSlides;
    let current = 0;

    function updateCarousel() {
        const offset = (current / totalSlides) * 100;
        track.style.transform = `translateX(-${offset}%)`;
    }

    document.getElementById("next")?.addEventListener("click", () => {
        current = current < maxOffset ? current + 1 : 0;
        updateCarousel();
    });

    document.getElementById("prev")?.addEventListener("click", () => {
        current = current > 0 ? current - 1 : maxOffset;
        updateCarousel();
    });
</script>
